    echo "提示:"
    echo "  - 上下文加載後，Cline 可以訪問項目信息"
    echo "  - 建議在開始新任務前加載上下文"
    echo "  - 定期清理舊文件以節省空間"
}

# 主函數
main() {
    local action="${1:-help}"
    
    case "$action" in
        load|--load)
            load_context
            ;;
        status|--status)
            check_status
            ;;
        test|--test)
            test_context
            ;;
        cleanup|--cleanup)
            cleanup
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            error "未知命令: $action"
            show_help
            return 1
            ;;
    esac
    
    return $?
}

# 執行
main "$@"
