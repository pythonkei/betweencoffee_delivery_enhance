        echo "│   ├── _executeOrderAction await + notifyAllListeners"
        echo "│   ├── registerListener 直接渲染（跳過 isActiveTab）"
        echo "│   ├── isLoading 鎖修復（_pendingRefreshAfterLoad flag）"
        echo "│   ├── QueueManager startPreparation await + notifyAllListeners"
        echo "│   ├── 倒數計時器延遲修復（cleanupTimers 不再停止全域 timer）"
        echo "│   ├── 子徽章空訂單歸零修復"
        echo "│   └── verify_flow_fix.py 端到端驗證腳本（50/50 測試通過 ✅）"
        echo "│"
        echo "│   Phase 4 — 效能優化與架構精簡"
        echo "│   ├── A1: 統一 all_data 渲染，消除 redundant 通知"
