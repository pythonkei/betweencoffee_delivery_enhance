[flake8]
ignore = E203, W503, E501
max-line-length = 88
exclude = .git, __pycache__, migrations, *.pyc, venv, env, .env, .venv, node_modules, .pants.d, .nox, .mypy_cache, buck-out, .bzr, _build, .hg, .svn, .direnv, .tox, .eggs, build, dist, __pypackages__, .pytype
filename = *.py
statistics = True
count = True
per-file-ignores = __init__.py: F401
